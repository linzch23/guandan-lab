{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Quiz",
  "anyOf": [
    {
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "trackId",
        "difficulty",
        "prompt",
        "skillIds",
        "lessonIds",
        "sourceIds",
        "explanation",
        "review",
        "type",
        "options",
        "correctOptionId"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "number"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9-]*$",
          "type": "string"
        },
        "trackId": {
          "anyOf": [
            {
              "const": "beginner",
              "type": "string"
            },
            {
              "const": "skills",
              "type": "string"
            }
          ]
        },
        "difficulty": {
          "anyOf": [
            {
              "const": 1,
              "type": "number"
            },
            {
              "const": 2,
              "type": "number"
            },
            {
              "const": 3,
              "type": "number"
            }
          ]
        },
        "prompt": {
          "minLength": 1,
          "type": "string"
        },
        "skillIds": {
          "minItems": 1,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "type": "string"
          }
        },
        "lessonIds": {
          "minItems": 1,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "type": "string"
          }
        },
        "sourceIds": {
          "minItems": 1,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "type": "string"
          }
        },
        "explanation": {
          "minLength": 1,
          "type": "string"
        },
        "review": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "anyOf": [
                {
                  "const": "draft",
                  "type": "string"
                },
                {
                  "const": "approved",
                  "type": "string"
                }
              ]
            },
            "reviewer": {
              "minLength": 1,
              "type": "string"
            },
            "reviewedAt": {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            }
          }
        },
        "type": {
          "const": "choice",
          "type": "string"
        },
        "options": {
          "minItems": 2,
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "pattern": "^[a-z][a-z0-9-]*$",
                "type": "string"
              },
              "label": {
                "minLength": 1,
                "type": "string"
              }
            }
          }
        },
        "correctOptionId": {
          "pattern": "^[a-z][a-z0-9-]*$",
          "type": "string"
        },
        "feedbackByOption": {
          "type": "object",
          "patternProperties": {
            "^[a-z][a-z0-9-]*$": {
              "minLength": 1,
              "type": "string"
            }
          }
        }
      }
    },
    {
